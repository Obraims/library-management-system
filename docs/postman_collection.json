{
  "info": {
    "name": "Library Management System API",
    "description": "Complete Book API, Auth & Authorization Postman Collection"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "genreId",
      "value": ""
    },
    {
      "key": "bookId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Patron",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"patron@library.com\", \"password\": \"Password123!\", \"name\": \"Patron User\", \"role\": \"PATRON\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"admin@library.com\", \"password\": \"Password123!\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login"
            }
          }
        }
      ]
    },
    {
      "name": "Genres",
      "item": [
        {
          "name": "Get All Genres",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/genres"
            }
          }
        },
        {
          "name": "Create Genre",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/genres"
            }
          }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "Get Books (Filter, Search & Pagination)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books?search=code&page=1&limit=10"
            }
          }
        },
        {
          "name": "Create Book",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/books"
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users/profile"
            }
          }
        }
      ]
    }
  ]
}